.vs/
obj/
bin/
dist/
dist-standalone/
# Ignore executables and PDBs except the installer and MSI in landing/
*.exe
!landing/FolderSizeAurora.exe
!landing/FolderSizeAurora.msi
*.pdb
*.vsidx
*.user
*.suo
*.log
*.tmp
*.bak
*.bak2
.DS_Store
Thumbs.db*.wixobj
*.wixpdb
FolderSizeAurora.wixobj

# Artefactos de compilacion del instalador: se regeneran con
# installer\Build-Installer.ps1. El fuente (.wxs) y el script SI se versionan.
installer/*.msi
installer/*.wixpdb
installer/*.wixobj
