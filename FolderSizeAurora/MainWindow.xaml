<Window x:Class="FolderSizeAurora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Size Aurora"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Bg.Ground}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!--
            Menu contextual de la fila.

            Va como recurso y se engancha al contenedor de la fila, no a la lista:
            un ContextMenu vive en un arbol visual aparte, asi que desde dentro no
            se llega al ViewModel por RelativeSource. Al abrirse se le da el
            ViewModel como DataContext (RowMenuOpening) y cada elemento recupera la
            fila por PlacementTarget, que si es la fila pinchada con el derecho.

            Lo que no aplica a una carpeta se esconde por tipo de fila, y el
            separador de las acciones de carpeta tambien: si no, en un archivo
            quedarian dos separadores seguidos al final.
        -->
        <ContextMenu x:Key="RowMenu" Opened="RowMenuOpened">
            <MenuItem Header="Abrir en el Explorador de archivos"
                      Command="{Binding OpenFolderInExplorerCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Geo.Open}" Style="{StaticResource Ico}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Abrir el archivo"
                      Command="{Binding OpenFileCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Geo.Open}" Style="{StaticResource Ico}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Mostrar en el Explorador de archivos"
                      Command="{Binding RevealInExplorerCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Geo.Folder}" Style="{StaticResource Ico}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="Abrir en PowerShell"
                      ToolTip="Abre una consola en esa carpeta"
                      Command="{Binding OpenTerminalCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Geo.Terminal}" Style="{StaticResource Ico}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="Analizar solo esta carpeta"
                      ToolTip="Vuelve a analizar desde aqui, sin el resto de la unidad"
                      Command="{Binding ScanFolderCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Ico}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Vigilar esta carpeta"
                      ToolTip="Añade una regla de limite a esta carpeta en la pestaña Vigilancia"
                      Command="{Binding WatchFolderCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Geo.Bell}" Style="{StaticResource Ico}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />

            <MenuItem Header="Copiar ruta"
                      Command="{Binding CopyPathCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Geo.Copy}" Style="{StaticResource Ico}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Fila del arbol. Las columnas se declaran con la misma medida que las
             cabeceras: cabecera y fila no pueden desfasarse porque comparten valores. -->
        <DataTemplate x:Key="RowTpl">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>

                <!-- Nombre: riel de chevrones, icono de clase y recorte -->
                <Grid Grid.Column="0" Margin="{Binding Indent, Converter={StaticResource Indent}, ConverterParameter=10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ToggleButton Style="{StaticResource Chevron}"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                      IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                      ToolTip="Desplegar o recoger"
                                      Command="{Binding DataContext.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                      CommandParameter="{Binding}">
                            <Grid>
                                <Path Data="{StaticResource Geo.ChevronRight}" Style="{StaticResource Ico}"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <Path Data="{StaticResource Geo.ChevronDown}" Style="{StaticResource Ico}"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </ToggleButton>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Path Data="{StaticResource Geo.Folder}" Style="{StaticResource Ico}"
                              ToolTip="Carpeta"
                              Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />
                        <Path Data="{StaticResource Geo.File}" Style="{StaticResource Ico}"
                              ToolTip="Archivo"
                              Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <TextBlock Grid.Column="2" Style="{StaticResource T.Row}" Margin="8,0,0,0" Text="{Binding Name}" />
                </Grid>

                <TextBlock Grid.Column="1" Text="{Binding DisplaySize}"
                           Style="{StaticResource T.Numeric.Strong}" VerticalAlignment="Center" Margin="0,0,15,0" />

                <!-- Uso: la barra que da la lectura instantanea sin sumar la columna -->
                <Grid Grid.Column="2" Height="6" VerticalAlignment="Center" Margin="14,0,14,0">
                    <Border x:Name="BarTrack" Background="{DynamicResource Rule.Hair}" CornerRadius="3" />
                    <Border HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Accent}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource FracToWidth}">
                                <Binding Path="BarFraction" />
                                <Binding Path="ActualWidth" ElementName="BarTrack" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Grid>

                <TextBlock Grid.Column="3" Text="{Binding DisplayFiles}"
                           Style="{StaticResource T.Numeric}" VerticalAlignment="Center" Margin="0,0,15,0" />

                <TextBlock Grid.Column="4" Text="{Binding DisplayFolders}"
                           Style="{StaticResource T.Numeric}" VerticalAlignment="Center" Margin="0,0,15,0" />

                <TextBlock Grid.Column="5" Text="{Binding DisplayModified}"
                           Style="{StaticResource T.Numeric}" VerticalAlignment="Center" Margin="0,0,15,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OptionTpl">
            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Base}" />
        </DataTemplate>

        <!-- Unidad del carril lateral -->
        <DataTemplate x:Key="DriveTpl">
            <Grid ToolTip="{Binding Root}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource Geo.Drive}" Style="{StaticResource Ico}"
                      ToolTip="{Binding DisplayVolume}" />

                <StackPanel Grid.Column="1" Margin="8,0,4,0"
                            Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Row}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DisplayFreeLabel}" Style="{StaticResource T.Micro}" Margin="0,2,0,0" />
                    <Grid Height="4" Margin="0,6,0,0">
                        <Border x:Name="DriveTrack" Background="{DynamicResource Rule.Hair}" CornerRadius="2" />
                        <Border HorizontalAlignment="Left" CornerRadius="2"
                                Background="{Binding UsedFraction, Converter={StaticResource LevelBrush}}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource FracToWidth}">
                                    <Binding Path="UsedFraction" />
                                    <Binding Path="ActualWidth" ElementName="DriveTrack" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="Ventana">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             BARRA SUPERIOR
             ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Rule.Hair}"
                BorderThickness="0,0,0,1">
            <Grid Height="48" Margin="10,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ico}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Mostrar u ocultar las unidades  (Ctrl+B)">
                        <Path Data="{StaticResource Geo.Menu}" Style="{StaticResource Ico}" />
                    </Button>
                    <Border Style="{StaticResource VDivider}" />
                    <TextBlock Text="Folder Size Aurora" Style="{StaticResource T.Wordmark}" />
                </StackPanel>

                <!-- La ruta no se edita aqui: es un campo de lectura, no un control de entrada -->
                <Border Grid.Column="1"
                        Margin="14,0,14,0"
                        Height="28"
                        Background="{DynamicResource Bg.Sunken}"
                        BorderBrush="{DynamicResource Rule.Hair}"
                        BorderThickness="1"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding CurrentPath, Mode=OneWay}"
                               FontFamily="{StaticResource F.Mono}"
                               FontSize="11.5"
                               Foreground="{DynamicResource Ink2}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="9,0"
                               ToolTip="{Binding CurrentPath}" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding BrowseCommand}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Geo.Folder}" Style="{StaticResource Ico}"
                                  Stroke="{DynamicResource Ink.OnAccent}" Margin="0,0,8,0" />
                            <TextBlock Text="Analizar carpeta" Foreground="{DynamicResource Ink.OnAccent}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Btn.Ico}" Command="{Binding RescanCommand}" Margin="0,0,6,0"
                            ToolTip="Volver a analizar la ruta actual  (Ctrl+R)">
                        <Path Data="{StaticResource Geo.Sync}" Style="{StaticResource Ico}" />
                    </Button>

                    <Button Style="{StaticResource Btn.Ico}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                            ToolTip="Detener el analisis en curso">
                        <Path Data="{StaticResource Geo.Stop}" Style="{StaticResource Ico}" />
                    </Button>

                    <Border Style="{StaticResource VDivider}" Margin="8,0" />

                    <Button Style="{StaticResource Btn.Ico}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Cambiar entre tema claro y oscuro  (Ctrl+D)">
                        <Grid>
                            <Path Data="{StaticResource Geo.Sun}" Style="{StaticResource Ico}"
                                  Visibility="{Binding IsDark, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Path Data="{StaticResource Geo.Moon}" Style="{StaticResource Ico}"
                                  Visibility="{Binding IsDark, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             CUERPO: CARRIL + PESTANAS
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Carril lateral -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Bg.Panel}"
                    Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarW}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="36" Margin="12,0,8,0">
                        <TextBlock Text="UNIDADES" Style="{StaticResource T.Section}"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <Button Style="{StaticResource Btn.Ico}" HorizontalAlignment="Right"
                                Command="{Binding RefreshDrivesCommand}"
                                ToolTip="Volver a leer las unidades del equipo"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <Path Data="{StaticResource Geo.Sync}" Style="{StaticResource Ico}" />
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Drives}"
                             SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                             ItemTemplate="{StaticResource DriveTpl}"
                             MouseDoubleClick="OnDriveDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource L.BoxItem}">
                                <Setter Property="Height" Value="Auto" />
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="Margin" Value="8,0,6,2" />
                                <Setter Property="Padding" Value="4,6,4,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="12,10,12,12"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource T.Section}" Text="LECTURA" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding SizePresets}"
                                  ItemTemplate="{StaticResource OptionTpl}"
                                  SelectedItem="{Binding MinSizeOption, Mode=TwoWay}"
                                  ToolTip="Ignorar todo lo que pese menos que esto" />
                        <CheckBox IsChecked="{Binding IncludeSystemHidden}" Margin="0,8,0,0"
                                  Content="Incluir ocultos y del sistema" />
                        <TextBlock Style="{StaticResource T.Micro}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Doble clic en una unidad para analizarla entera." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Rule.Hair}" />

            <!-- PESTANAS -->
            <TabControl Grid.Column="2">

                <!-- ============================ EXPLORADOR ============================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Geo.Tree}" Style="{StaticResource Ico}" Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <TextBlock Text="Explorador" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="16,12,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Riel de filtros -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" MaxWidth="260" HorizontalAlignment="Left">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="30,0,8,0"
                                         ToolTip="Quedate solo con los elementos cuyo nombre contenga este texto" />
                                <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Ico}"
                                      Width="14" Height="14" StrokeThickness="1.2"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="9,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="Filtrar por nombre" Style="{StaticResource T.Dim}"
                                           Margin="31,0,0,0" IsHitTestVisible="False"
                                           Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>

                            <ComboBox Grid.Column="1" Width="132" Margin="8,0,0,0"
                                      ItemsSource="{Binding TypeFilters}"
                                      ItemTemplate="{StaticResource OptionTpl}"
                                      SelectedItem="{Binding TypeFilterOption, Mode=TwoWay}"
                                      ToolTip="Limitar el analisis a un tipo de archivo" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <ComboBox Width="134"
                                          ItemsSource="{Binding SortModes}"
                                          ItemTemplate="{StaticResource OptionTpl}"
                                          SelectedItem="{Binding SortModeOption, Mode=TwoWay}"
                                          ToolTip="Columna por la que se ordena el arbol" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource Btn.Ico}" Command="{Binding ExpandAllCommand}"
                                        ToolTip="Desplegar todo el arbol  (Ctrl+E)">
                                    <Path Data="{StaticResource Geo.Expand}" Style="{StaticResource Ico}" />
                                </Button>
                                <Button Style="{StaticResource Btn.Ico}" Command="{Binding CollapseAllCommand}"
                                        ToolTip="Recoger todo el arbol  (Ctrl+L)">
                                    <Path Data="{StaticResource Geo.Collapse}" Style="{StaticResource Ico}" />
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Style="{StaticResource Btn}" Command="{Binding ResetFiltersCommand}"
                                        Margin="0,0,8,0" ToolTip="Quitar filtro de nombre, tipo, orden y tamano minimo">
                                    <TextBlock Text="Restablecer" />
                                </Button>

                                <!-- Tres formatos en un boton: el riel no puede desbordarse
                                     en pantallas de 1024 px, que es donde se rompe el diseño. -->
                                <Button x:Name="ExportButton" Style="{StaticResource Btn.Ghost}"
                                        Width="30" Padding="0"
                                        Command="{Binding ToggleExportMenuCommand}"
                                        ToolTip="Guardar el resultado">
                                    <Path Data="{StaticResource Geo.File}" Style="{StaticResource Ico}" />
                                </Button>

                                <Popup x:Name="ExportPopup"
                                       PlacementTarget="{Binding ElementName=ExportButton}"
                                       Placement="Bottom" HorizontalOffset="-6" VerticalOffset="3"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Fade" StaysOpen="False"
                                       IsOpen="{Binding IsExportMenuOpen, Mode=TwoWay}">
                                    <Border Background="{DynamicResource Bg.Panel}"
                                            BorderBrush="{DynamicResource Rule.Strong}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            MinWidth="196"
                                            Padding="4">
                                        <StackPanel>
                                            <Button Style="{StaticResource Btn}" Command="{Binding ExportCsvCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30">
                                                <TextBlock Text="Archivo CSV" />
                                            </Button>
                                            <Button Style="{StaticResource Btn}" Command="{Binding ExportJsonCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30">
                                                <TextBlock Text="Archivo JSON" />
                                            </Button>
                                            <Button Style="{StaticResource Btn}" Command="{Binding ExportReportCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30">
                                                <TextBlock Text="Informe de texto" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>

                        <!-- Listado -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="HeaderRow" Grid.Row="0"
                                    Background="{DynamicResource Bg.Sunken}"
                                    BorderBrush="{DynamicResource Rule.Hair}"
                                    BorderThickness="0,0,0,1"
                                    Margin="12,0,0,0">
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource Head}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding SortByCommand}" CommandParameter="Name"
                                            ToolTip="Ordenar por nombre">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="NOMBRE" VerticalAlignment="Center" />
                                        <Grid Width="10" Height="10" Margin="6,0,0,0">
                                            <Path Data="{StaticResource Geo.TriangleUp}" Style="{StaticResource Ico.Fill}"
                                                  Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                  Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Name|up}" />
                                            <Path Data="{StaticResource Geo.TriangleDown}" Style="{StaticResource Ico.Fill}"
                                                  Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                  Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Name|down}" />
                                        </Grid>
                                    </StackPanel>
                                </Button>

                                    <Button Grid.Column="1" Style="{StaticResource Head}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding SortByCommand}" CommandParameter="Size"
                                            ToolTip="Ordenar por tamano">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="TAMANO" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <Grid Grid.Column="1" Width="10" Height="10">
                                                <Path Data="{StaticResource Geo.TriangleUp}" Style="{StaticResource Ico.Fill}"
                                                      Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                      Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Size|up}" />
                                                <Path Data="{StaticResource Geo.TriangleDown}" Style="{StaticResource Ico.Fill}"
                                                      Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                      Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Size|down}" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <TextBlock Grid.Column="2" Text="USO DEL TOTAL" Style="{StaticResource Head.Label}"
                                               HorizontalAlignment="Left" Margin="14,0,0,0"
                                               ToolTip="Proporcion de bytes que representa la fila" />

                                    <Button Grid.Column="3" Style="{StaticResource Head}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding SortByCommand}" CommandParameter="Files"
                                            ToolTip="Ordenar por cantidad de archivos">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ARCHIVOS" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <Grid Grid.Column="1" Width="10" Height="10">
                                                <Path Data="{StaticResource Geo.TriangleUp}" Style="{StaticResource Ico.Fill}"
                                                      Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                      Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Files|up}" />
                                                <Path Data="{StaticResource Geo.TriangleDown}" Style="{StaticResource Ico.Fill}"
                                                      Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                      Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Files|down}" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <TextBlock Grid.Column="4" Text="CARPETAS" Style="{StaticResource Head.Label}"
                                               HorizontalAlignment="Right" Margin="0,0,15,0" />

                                    <Button Grid.Column="5" Style="{StaticResource Head}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding SortByCommand}" CommandParameter="Date"
                                            ToolTip="Ordenar por ultima modificacion">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="MODIFICADO" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <Grid Grid.Column="1" Width="10" Height="10">
                                                <Path Data="{StaticResource Geo.TriangleUp}" Style="{StaticResource Ico.Fill}"
                                                      Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                      Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Date|up}" />
                                                <Path Data="{StaticResource Geo.TriangleDown}" Style="{StaticResource Ico.Fill}"
                                                      Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                                      Visibility="{Binding DataContext.SortIndicator, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SortArrow}, ConverterParameter=Date|down}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <ListView x:Name="Tree" Grid.Row="1"
                                      Padding="12,0,0,0"
                                      ItemsSource="{Binding Rows}"
                                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource RowTpl}">
                                <!-- El menu va en el contenedor de la fila: pinchar con
                                     el derecho en cualquier punto de la fila lo abre. -->
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource L.Row}">
                                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>

                            <!-- Estado vacio: explica que hacer, no solo dice que no hay nada -->
                            <StackPanel Grid.Row="1" MaxWidth="430" Margin="24"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <Path Data="{StaticResource Geo.Tree}" Style="{StaticResource Ico}"
                                      Width="26" Height="26" StrokeThickness="1.1"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="Todavia no hay ningun analisis" Style="{StaticResource T.Wordmark}"
                                           FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource T.Label}" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,6,0,0"
                                           Text="Elige una unidad en el carril de la izquierda y haz doble clic, o pulsa Analizar carpeta para señalar cualquier carpeta del equipo." />
                            </StackPanel>
                        </Grid>

                        <!-- Detalle de la fila seleccionada -->
                        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource Accent}"
                                        CornerRadius="2" Margin="0,1,12,1" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SelectionTitle}" Style="{StaticResource T.Row}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectionMeta}" Style="{StaticResource T.Micro}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectionPath}" Style="{StaticResource T.Micro}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                               ToolTip="{Binding SelectionPath}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="TOTAL DE LA LECTURA" Style="{StaticResource T.Section}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource T.Numeric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================ GRAFICOS ============================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Geo.Chart}" Style="{StaticResource Ico}" Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <TextBlock Text="Graficos" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer Padding="16,14,16,16" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Carpetas principales -->
                            <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,13,16,10">
                                        <TextBlock Text="CARPETAS QUE MAS OCUPAN" Style="{StaticResource T.Section}" />
                                        <TextBlock Text="{Binding TopFolders.Count, StringFormat={}{0} elementos}"
                                                   Style="{StaticResource T.Micro}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopFolders}" Margin="16,0,16,14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="28" ToolTip="{Binding Tooltip}">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Abrir carpeta" Command="{Binding DataContext.OpenChartItemPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Tooltip}" />
                                                            <MenuItem Header="Copiar ruta" Command="{Binding DataContext.CopyChartItemPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Tooltip}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="62" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource T.Row}"
                                                               Margin="0,0,14,0" />

                                                    <Grid Grid.Column="1" Width="180" Height="8" VerticalAlignment="Center">
                                                        <Border x:Name="BarTrack" Background="{DynamicResource Rule.Hair}" CornerRadius="4" />
                                                        <Border HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{Binding ColorIndex, Converter={StaticResource PaletteBrush}}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource FracToWidth}">
                                                                    <Binding Path="Fraction" />
                                                                    <Binding Path="ActualWidth" ElementName="BarTrack" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySize}"
                                                               Style="{StaticResource T.Numeric}" Margin="14,0,0,0" />

                                                    <TextBlock Grid.Column="3" Text="{Binding DisplayPercent}"
                                                               Style="{StaticResource T.Numeric}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="1" Style="{StaticResource T.Label}" TextAlignment="Center"
                                               Margin="16,0,16,16" Text="Aun no hay datos que representar."
                                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>

                            <!-- Archivos principales -->
                            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,13,16,10">
                                        <TextBlock Text="ARCHIVOS MAS PESADOS" Style="{StaticResource T.Section}" />
                                        <TextBlock Text="{Binding TopFiles.Count, StringFormat={}{0} elementos}"
                                                   Style="{StaticResource T.Micro}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopFiles}" Margin="16,0,16,14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="28" ToolTip="{Binding Tooltip}">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Abrir carpeta" Command="{Binding DataContext.OpenChartItemPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Tooltip}" />
                                                            <MenuItem Header="Copiar ruta" Command="{Binding DataContext.CopyChartItemPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Tooltip}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="62" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource T.Row}"
                                                               Margin="0,0,14,0" />

                                                    <Grid Grid.Column="1" Width="180" Height="8" VerticalAlignment="Center">
                                                        <Border x:Name="BarTrack" Background="{DynamicResource Rule.Hair}" CornerRadius="4" />
                                                        <Border HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{Binding ColorIndex, Converter={StaticResource PaletteBrush}}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource FracToWidth}">
                                                                    <Binding Path="Fraction" />
                                                                    <Binding Path="ActualWidth" ElementName="BarTrack" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySize}"
                                                               Style="{StaticResource T.Numeric}" Margin="14,0,0,0" />

                                                    <TextBlock Grid.Column="3" Text="{Binding DisplayPercent}"
                                                               Style="{StaticResource T.Numeric}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="1" Style="{StaticResource T.Label}" TextAlignment="Center"
                                               Margin="16,0,16,16" Text="Aun no hay datos que representar."
                                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>

                            <!-- Por extension -->
                            <Border Grid.Row="2" Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,13,16,10">
                                        <TextBlock Text="REPARTO POR EXTENSION" Style="{StaticResource T.Section}" />
                                        <TextBlock Text="{Binding ByExtension.Count, StringFormat={}{0} extensiones}"
                                                   Style="{StaticResource T.Micro}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ByExtension}" Margin="16,0,16,14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="28" ToolTip="{Binding Tooltip}">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Copiar extensión" Command="{Binding DataContext.CopyChartItemPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Label}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="62" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource T.Row}"
                                                               Margin="0,0,14,0" />

                                                    <Grid Grid.Column="1" Width="180" Height="8" VerticalAlignment="Center">
                                                        <Border x:Name="BarTrack" Background="{DynamicResource Rule.Hair}" CornerRadius="4" />
                                                        <Border HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{Binding ColorIndex, Converter={StaticResource PaletteBrush}}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource FracToWidth}">
                                                                    <Binding Path="Fraction" />
                                                                    <Binding Path="ActualWidth" ElementName="BarTrack" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySize}"
                                                               Style="{StaticResource T.Numeric}" Margin="14,0,0,0" />

                                                    <TextBlock Grid.Column="3" Text="{Binding DisplayPercent}"
                                                               Style="{StaticResource T.Numeric}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="1" Style="{StaticResource T.Label}" TextAlignment="Center"
                                               Margin="16,0,16,16" Text="Aun no hay datos que representar."
                                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================ VIGILANCIA ============================ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Geo.Bell}" Style="{StaticResource Ico}" Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <TextBlock Text="Vigilancia" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer Padding="16,14,16,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Reglas -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,12,10,8">
                                        <TextBlock Text="REGLAS DE LIMITE" Style="{StaticResource T.Section}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Btn}" Command="{Binding AddFolderRuleCommand}" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Geo.Plus}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                                    <TextBlock Text="Carpeta" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn}" Command="{Binding CheckNowCommand}" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Geo.Sync}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                                    <TextBlock Text="Comprobar" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Ico}" Command="{Binding RemoveRuleCommand}"
                                                    ToolTip="Quitar la regla seleccionada">
                                                <Path Data="{StaticResource Geo.Trash}" Style="{StaticResource Ico}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Style="{StaticResource Divider}" />

                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding MonitorRows}"
                                             SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                             Margin="0,0,0,0">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource L.BoxItem}">
                                                <Setter Property="Height" Value="Auto" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Padding" Value="16,10,16,10" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Path}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0">
                                                        <Path Data="{StaticResource Geo.Folder}" Style="{StaticResource Ico}"
                                                              Visibility="{Binding Target.Kind, Converter={StaticResource EnumToVis}, ConverterParameter=Folder}" />
                                                        <Path Data="{StaticResource Geo.Drive}" Style="{StaticResource Ico}"
                                                              Visibility="{Binding Target.Kind, Converter={StaticResource EnumToVis}, ConverterParameter=Drive}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="10,0,14,0">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource T.Row}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding KindLine}" Style="{StaticResource T.Micro}"
                                                                   Margin="0,3,0,0" />
                                                        <Grid Height="4" Margin="0,8,0,0" MaxWidth="320" HorizontalAlignment="Left">
                                                            <Border x:Name="RuleTrack" Background="{DynamicResource Rule.Hair}" CornerRadius="2" />
                                                            <Border HorizontalAlignment="Left" CornerRadius="2"
                                                                    Background="{Binding Exceeded, Converter={StaticResource FlagBrush}}">
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{StaticResource FracToWidth}">
                                                                        <Binding Path="BarFraction" />
                                                                        <Binding Path="ActualWidth" ElementName="RuleTrack" />
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StateText}"
                                                                   Style="{StaticResource T.Numeric}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Exceeded, Converter={StaticResource FlagBrush}}" />
                                                        <TextBlock Style="{StaticResource T.Micro}" Margin="0,3,0,0"
                                                                   HorizontalAlignment="Right"
                                                                   Text="{Binding DisplayUsed}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Grid.Row="2" Style="{StaticResource T.Label}" TextAlignment="Center"
                                               Margin="16,18,16,20"
                                               Text="Sin reglas. Anade una carpeta o una unidad y la aplicacion te avisara cuando se pase del limite."
                                               Visibility="{Binding MonitorRows.Count, Converter={StaticResource CountToVis}}" />
                                </Grid>
                            </Border>

                            <!-- Vigilancia y canales -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <StackPanel Margin="16,13,16,15">
                                    <TextBlock Text="VIGILANCIA" Style="{StaticResource T.Section}" Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton IsChecked="{Binding MonitoringEnabled}" Content="Vigilancia activa" />
                                        <ComboBox Width="150" Margin="10,0,0,0"
                                                  ItemsSource="{Binding IntervalPresets}"
                                                  ItemTemplate="{StaticResource OptionTpl}"
                                                  SelectedItem="{Binding MonitorIntervalOption, Mode=TwoWay}"
                                                  ToolTip="Cada cuanto se comprueban las reglas" />
                                        <Button Style="{StaticResource Btn}" Command="{Binding CheckNowCommand}" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Geo.Sync}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                                <TextBlock Text="Comprobar ahora" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border Style="{StaticResource Divider}" Margin="0,13" />

                                    <TextBlock Text="CANALES DE AVISO" Style="{StaticResource T.Section}" Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <CheckBox IsChecked="{Binding NotifyInApp}" Content="Dentro de la aplicacion" Margin="0,0,20,6" />
                                        <CheckBox IsChecked="{Binding NotifySound}" Content="Sonido del sistema" Margin="0,0,20,6" />
                                        <CheckBox IsChecked="{Binding NotifyEmail}" Content="Correo electronico" Margin="0,0,20,6" />
                                        <CheckBox IsChecked="{Binding NotifyWebhook}" Content="Webhook HTTP" Margin="0,0,20,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Correo -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12"
                                    Visibility="{Binding NotifyEmail, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="16,13,16,15">
                                    <TextBlock Text="CORREO DE SALIDA" Style="{StaticResource T.Section}" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Servidor" Style="{StaticResource T.Label}" Margin="0,0,10,8" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"
                                                 Text="{Binding SmtpHost, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding SmtpPortText, UpdateSourceTrigger=LostFocus}"
                                                 FontFamily="{StaticResource F.Mono}" ToolTip="Puerto SMTP" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Usuario" Style="{StaticResource T.Label}" Margin="0,0,10,8" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"
                                                 Text="{Binding SmtpUser, UpdateSourceTrigger=LostFocus}" />
                                        <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding SmtpUseSsl}" Content="TLS" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Clave" Style="{StaticResource T.Label}" Margin="0,0,10,0" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"
                                                 Text="{Binding SmtpPassword, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Remitente" Style="{StaticResource T.Label}" Margin="0,12,10,8" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,12,8,8"
                                                 Text="{Binding EmailFrom, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Destinatario" Style="{StaticResource T.Label}" Margin="0,0,10,0" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,8,0"
                                                 Text="{Binding EmailTo, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Webhook -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12"
                                    Visibility="{Binding NotifyWebhook, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="16,13,16,15">
                                    <TextBlock Text="WEBHOOK" Style="{StaticResource T.Section}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="URL" Style="{StaticResource T.Label}" Margin="0,0,10,8" />
                                        <TextBox Grid.Column="1" Margin="0,0,0,8"
                                                 Text="{Binding WebhookUrl, UpdateSourceTrigger=LostFocus}"
                                                 FontFamily="{StaticResource F.Mono}"
                                                 ToolTip="Se envia un POST en JSON con la alerta" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Alertas -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,12,10,8">
                                        <TextBlock Text="AVISOS" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Btn}" Command="{Binding ClearAlertsCommand}"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding Alerts.Count, Converter={StaticResource CountToVis}}">
                                            <TextBlock Text="Vaciar historial" />
                                        </Button>
                                    </Grid>

                                    <Border Grid.Row="1" Style="{StaticResource Divider}" />

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Alerts}" MaxHeight="230">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="16,10,16,10" ToolTip="{Binding Path}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Path Data="{StaticResource Geo.Warn}" Style="{StaticResource Ico}"
                                                          Stroke="{DynamicResource Danger}"
                                                          ToolTip="Se ha superado el limite" />

                                                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource T.Row}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource T.Micro}"
                                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                               Style="{StaticResource T.Numeric}" VerticalAlignment="Top" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="2" Style="{StaticResource T.Label}" TextAlignment="Center"
                                               Margin="16,18,16,20"
                                               Text="Ningun aviso por ahora. Cuando una regla se pase, aparecera aqui."
                                               Visibility="{Binding Alerts.Count, Converter={StaticResource CountToVis}}" />
                                </Grid>
                            </Border>

                            <!-- Entregas -->
                            <Border Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,12,16,8">
                                        <TextBlock Text="ENTREGAS DE LOS AVISOS" Style="{StaticResource T.Section}" />
                                        <Button Style="{StaticResource Btn}" Command="{Binding SendTestNotificationCommand}"
                                                HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Geo.Mail}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                                <TextBlock Text="Enviar prueba" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border Grid.Row="1" Style="{StaticResource Divider}" />

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Notifications}" MaxHeight="190">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="16,9,16,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Path Data="{StaticResource Geo.Check}" Style="{StaticResource Ico}"
                                                          Stroke="{DynamicResource Ok}"
                                                          Visibility="{Binding Success, Converter={StaticResource BoolToVis}}" />
                                                    <Path Data="{StaticResource Geo.Warn}" Style="{StaticResource Ico}"
                                                          Stroke="{DynamicResource Danger}"
                                                          Visibility="{Binding Success, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Channel}"
                                                               Style="{StaticResource T.Row}" Margin="10,0,12,0"
                                                               FontWeight="SemiBold" />

                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                               Style="{StaticResource T.Micro}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="2" Style="{StaticResource T.Label}" TextAlignment="Center"
                                               Margin="16,18,16,20"
                                               Text="Aun no se ha enviado ningun aviso. Prueba los canales con el boton de arriba."
                                               Visibility="{Binding Notifications.Count, Converter={StaticResource CountToVis}}" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- ============================================================
             AVISO FLOTANTE
             ============================================================ -->
        <Border Grid.Row="1"
                Width="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Padding="14,12"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Rule.Strong}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource Geo.Warn}" Style="{StaticResource Ico}" Stroke="{DynamicResource Danger}"
                      VerticalAlignment="Top" Margin="0,1,0,0" />

                <StackPanel Grid.Column="1" Margin="11,0,10,0">
                    <TextBlock Text="{Binding ToastMessage}" Style="{StaticResource T.Row}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ToastPath}" Style="{StaticResource T.Micro}"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ToastPath}" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource Btn.Ico}" VerticalAlignment="Top"
                        Command="{Binding DismissToastCommand}" ToolTip="Descartar este aviso">
                    <Path Data="{StaticResource Geo.Close}" Style="{StaticResource Ico}" />
                </Button>
            </Grid>
        </Border>

        <!-- ============================================================
             PIE DE ESTADO
             ============================================================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Rule.Hair}"
                BorderThickness="0,1,0,0">
            <Grid Height="28" Margin="12,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="88" Height="3" VerticalAlignment="Center" Margin="0,0,11,0"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Dim}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Ctrl+B unidades   ·   Ctrl+O analizar   ·   Ctrl+R repetir   ·   Ctrl+E desplegar"
                           Style="{StaticResource T.Micro}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>