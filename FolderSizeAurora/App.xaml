<Application x:Class="FolderSizeAurora.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FolderSizeAurora.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- El diccionario de tema (Light/Dark) lo inserta ThemeService en el indice 0 -->
                <ResourceDictionary Source="/Themes/Light.xaml" />
                <ResourceDictionary Source="/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convertidores con clave, usados por el XAML de las vistas -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:FractionToWidthConverter x:Key="FracToWidth" />
            <conv:PaletteBrushConverter x:Key="PaletteBrush" />
            <conv:StateBrushConverter x:Key="StateBrush" />
            <conv:EnumLabelConverter x:Key="EnumLabel" />
            <conv:IndentToMarginConverter x:Key="Indent" />
            <conv:SidebarWidthConverter x:Key="SidebarW" />
            <conv:SortArrowConverter x:Key="SortArrow" />
            <conv:LevelBrushConverter x:Key="LevelBrush" />
            <conv:FlagBrushConverter x:Key="FlagBrush" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>