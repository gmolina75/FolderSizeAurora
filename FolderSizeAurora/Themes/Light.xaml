<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Tema claro - "Registro de sondeo"
         Papel casi blanco, tinta nunca negra, un solo acento.
         ============================================================ -->

    <Color x:Key="C.Ground">#FFF7F8FA</Color>
    <Color x:Key="C.Panel">#FFFFFFFF</Color>
    <Color x:Key="C.PanelSunken">#FFF1F3F6</Color>
    <Color x:Key="C.RowHover">#FFEFF4FB</Color>
    <Color x:Key="C.RowSelected">#FFE3EDFD</Color>
    <Color x:Key="C.Rule">#FFE3E7ED</Color>
    <Color x:Key="C.RuleStrong">#FFCBD3DE</Color>
    <Color x:Key="C.Ink">#FF101418</Color>
    <Color x:Key="C.Ink2">#FF5B6672</Color>
    <Color x:Key="C.Ink3">#FF8A94A0</Color>
    <Color x:Key="C.Accent">#FF1F6FEB</Color>
    <Color x:Key="C.AccentHover">#FF1A5FD0</Color>
    <Color x:Key="C.AccentSoft">#FFDCE8FD</Color>
    <Color x:Key="C.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="C.Ok">#FF1F8B4C</Color>
    <Color x:Key="C.Warn">#FFB26A00</Color>
    <Color x:Key="C.Danger">#FFC0392B</Color>

    <SolidColorBrush x:Key="Bg.Ground" Color="{StaticResource C.Ground}" />
    <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="{StaticResource C.PanelSunken}" />
    <SolidColorBrush x:Key="Bg.Hover" Color="{StaticResource C.RowHover}" />
    <SolidColorBrush x:Key="Bg.Selected" Color="{StaticResource C.RowSelected}" />
    <SolidColorBrush x:Key="Bg.AccentSoft" Color="{StaticResource C.AccentSoft}" />
    <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource C.Panel}" />

    <SolidColorBrush x:Key="Rule.Hair" Color="{StaticResource C.Rule}" />
    <SolidColorBrush x:Key="Rule.Strong" Color="{StaticResource C.RuleStrong}" />

    <SolidColorBrush x:Key="Ink" Color="{StaticResource C.Ink}" />
    <SolidColorBrush x:Key="Ink2" Color="{StaticResource C.Ink2}" />
    <SolidColorBrush x:Key="Ink3" Color="{StaticResource C.Ink3}" />
    <SolidColorBrush x:Key="Ink.OnAccent" Color="{StaticResource C.OnAccent}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}" />

    <!-- Paleta categorica: solo graficos -->
    <SolidColorBrush x:Key="Cat.0" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="Cat.1" Color="#FF10B981" />
    <SolidColorBrush x:Key="Cat.2" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="Cat.3" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="Cat.4" Color="#FFEC4899" />
    <SolidColorBrush x:Key="Cat.5" Color="#FF14B8A6" />

</ResourceDictionary>