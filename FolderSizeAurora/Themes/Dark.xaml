<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Tema oscuro - mismo sistema, ground profundo sin azul puro.
         ============================================================ -->

    <Color x:Key="C.Ground">#FF0F1216</Color>
    <Color x:Key="C.Panel">#FF161A20</Color>
    <Color x:Key="C.PanelSunken">#FF1C2128</Color>
    <Color x:Key="C.RowHover">#FF1F2530</Color>
    <Color x:Key="C.RowSelected">#FF1E2C42</Color>
    <Color x:Key="C.Rule">#FF252B34</Color>
    <Color x:Key="C.RuleStrong">#FF36404D</Color>
    <Color x:Key="C.Ink">#FFE9EDF3</Color>
    <Color x:Key="C.Ink2">#FF9AA6B4</Color>
    <Color x:Key="C.Ink3">#FF6B7683</Color>
    <Color x:Key="C.Accent">#FF4C8DFF</Color>
    <Color x:Key="C.AccentHover">#FF6BA1FF</Color>
    <Color x:Key="C.AccentSoft">#FF1B2A44</Color>
    <Color x:Key="C.OnAccent">#FF08101C</Color>
    <Color x:Key="C.Ok">#FF34D399</Color>
    <Color x:Key="C.Warn">#FFFBBF24</Color>
    <Color x:Key="C.Danger">#FFF87171</Color>

    <SolidColorBrush x:Key="Bg.Ground" Color="{StaticResource C.Ground}" />
    <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="{StaticResource C.PanelSunken}" />
    <SolidColorBrush x:Key="Bg.Hover" Color="{StaticResource C.RowHover}" />
    <SolidColorBrush x:Key="Bg.Selected" Color="{StaticResource C.RowSelected}" />
    <SolidColorBrush x:Key="Bg.AccentSoft" Color="{StaticResource C.AccentSoft}" />
    <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource C.PanelSunken}" />

    <SolidColorBrush x:Key="Rule.Hair" Color="{StaticResource C.Rule}" />
    <SolidColorBrush x:Key="Rule.Strong" Color="{StaticResource C.RuleStrong}" />

    <SolidColorBrush x:Key="Ink" Color="{StaticResource C.Ink}" />
    <SolidColorBrush x:Key="Ink2" Color="{StaticResource C.Ink2}" />
    <SolidColorBrush x:Key="Ink3" Color="{StaticResource C.Ink3}" />
    <SolidColorBrush x:Key="Ink.OnAccent" Color="{StaticResource C.OnAccent}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}" />

    <SolidColorBrush x:Key="Cat.0" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Cat.1" Color="#FF34D399" />
    <SolidColorBrush x:Key="Cat.2" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Cat.3" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="Cat.4" Color="#FFF472B6" />
    <SolidColorBrush x:Key="Cat.5" Color="#FF2DD4BF" />

</ResourceDictionary>